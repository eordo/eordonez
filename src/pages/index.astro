---
import Base from "../layouts/Base.astro";
import { site } from "../content/site";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  inLanguage: site.locale
};
---

<Base
  title={site.name}
  description={site.description}
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <article class="prose">
    <h1>{site.tagline}</h1>
    <p class="lead">{site.description}</p>

    <section class="block">
      <h2>What I do now</h2>
      <p>
        I am a master's student in Data Science and Artificial Intelligence, currently conducting 
        research in spatial data science and urban economics with 
        <a href="https://cambridgesquared.github.io">Cambridge Squared</a>.
      </p>
    </section>

    <section class="block">
      <h2>What I've done before</h2>
      <ul>
        <li>MicroMaster in Statistics and Data Science, MIT IDSS</li>
        <li>BA in Economics and Mathematics, UIUC</li>
      </ul>
    </section>
  </article>
</Base>
