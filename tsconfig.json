{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2020",
    "types": ["astro/client"],
    "paths": {
      "@/components/*": ["./src/components/*"],
      "@/content/*": ["./src/content/*"],
      "@/images/*": ["./src/assets/images/*"],
      "@/layouts/*": ["./src/layouts/*"],
      "@/styles/*": ["./src/styles/*"],
    }
  }
}
